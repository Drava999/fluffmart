+<script>
+/* ===== FloofMart cleanup pass ===== */
+(function(){
+  const tg=window.Telegram&&Telegram.WebApp;
+  // Pull-to-refresh and Telegram's swipe-to-close fight over the same drag.
+  try{ if(tg&&tg.isVersionAtLeast&&tg.isVersionAtLeast('7.7')) tg.disableVerticalSwipes(); }catch(e){}
+  // Telegram's own header/bottom bar match the cream app, and follow live theme switches.
+  function syncChrome(){ try{ const bg=getComputedStyle(document.body).backgroundColor;
+    if(tg&&tg.isVersionAtLeast&&tg.isVersionAtLeast('7.10')){ tg.setBackgroundColor(bg); tg.setBottomBarColor(bg); } }catch(e){} }
+  try{ tg&&tg.onEvent('themeChanged',()=>{ if(typeof applyPrefs==='function') applyPrefs(); syncChrome(); }); }catch(e){}
+  // Anything tappable that isn't a real button gets a role, a tab stop and Enter/Space.
+  const tag=()=>document.querySelectorAll('div[onclick]:not([role]),span[onclick]:not([role])').forEach(el=>{el.setAttribute('role','button');el.tabIndex=0;});
+  new MutationObserver(tag).observe(document.documentElement,{childList:true,subtree:true});
+  document.addEventListener('keydown',e=>{ const el=e.target; if((e.key==='Enter'||e.key===' ')&&el.matches&&el.matches('[role=button][onclick]')){ e.preventDefault(); el.click(); } });
+  // Settings toggles: announce as switches, with their row's title as the name.
+  function switches(){ document.querySelectorAll('button.switch').forEach(b=>{ b.setAttribute('role','switch');
+    b.setAttribute('aria-checked',b.classList.contains('on')?'true':'false');
+    if(!b.getAttribute('aria-label')){ const r=b.closest('.set-row'); const tt=r&&r.querySelector('.set-t'); if(tt) b.setAttribute('aria-label',tt.textContent.trim()); } }); }
+  new MutationObserver(switches).observe(document.documentElement,{subtree:true,attributes:true,attributeFilter:['class']});
+  addEventListener('DOMContentLoaded',()=>{ tag(); switches(); syncChrome(); });
+})();
+</script>
