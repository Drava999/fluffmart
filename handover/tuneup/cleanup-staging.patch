+/* ===== FloofMart cleanup pass ===== */
+/* 0 · two tokens a shade darker so pink/grey text clears 4.5:1 on cream (was 4.48 and 4.14) */
+:root{--fawn-deep:#9E4686;--berry-deep:#9E4686;--link:#9E4686}
+.jnew{color:#5f4500;font-size:9.5px}
+/* 1 · readable pink: white text needs >=4.5:1, berry gives 5.07:1 */
+.hero{background:linear-gradient(135deg,#A84E8E 0%,#9C4785 100%)!important}
+.chip.on{background:var(--fawn-deep);border-color:var(--fawn-deep)}
+.loyal-refb{background:var(--fawn-deep)!important;color:#fff}
+/* 2 · iOS stops auto-zooming inputs at 16px, so pinch-zoom can come back */
+input,textarea,select{font-size:16px!important}
+/* 3 · keyboard focus you can see */
+:focus-visible{outline:2px solid var(--fawn-deep);outline-offset:2px}
+/* 4 · close buttons: 44px tap target, same icon */
+.rm,.cv-close,.zoom-close{min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center}
+/* 9 · every main button: berry, not light pink (2.45:1 -> 5.72:1) */
+.cta{background:var(--fawn-deep)}
+.cta{box-shadow:0 6px 18px rgba(158,70,134,.28)}
+.wtab.on,.ostg.on,.pt-tabs .chip.on{background:var(--fawn-deep);border-color:var(--fawn-deep)}
+.rate-b{background:var(--fawn-deep)}
+.oact-hd{background:linear-gradient(135deg,#A84E8E,#9A4583)}
+/* 10 · status tags, timers and warnings: darker text on their own tints */
+.htag.ok{color:#237152}.htag.way{color:#2B6682}.htag.wait{color:#7F5A00}
