+:root[data-theme="dark"] :is(.cta,.cta *,.add,.wtab.on,.pt-tabs .chip.on,.ostg.on .ostg-v,.ostg.on .ostg-l,.rate-b,.fchip.on,.chip.on,.loyal-refb){color:#2A1024!important}
